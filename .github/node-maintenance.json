{
  "directory": "website",
  "toolchain": {
    "node": "24",
    "pnpm": "11.21.0"
  },
  "validationScript": "check",
  "minimumReleaseAgeDays": 10,
  "maintenance": {
    "mode": "security-and-maintenance",
    "upgradeScope": "major"
  },
  "schedule": {
    "security": [
      "0 2 * * 1"
    ],
    "upgrades": [
      "0 2 1 */3 *"
    ]
  }
}
